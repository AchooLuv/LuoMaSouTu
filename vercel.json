{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/iqdb(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/trace/(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/saucenao/(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}